/// @description  ini_stream();
function ini_stream() {
	/*-------------------------
	Setup stream object to 
	stream particles for a
	specific amount of time
	---------------------------*/

	/// set streaming variables
	period = 15;
	count = 5;
	radius = 16;
	particle = PARTICLE_ENGINE.pSmack;
	above = true;

	/// set movement properties
	friction = 0.5;
	gravity_direction = 270;
	gravity = 0;



}
