function scr_fix_cons_general() {
	// This code is generated by KeeVee Games Fixture Editor.
	// Place this code in the Create event or similar.

	var fix, offsetx, offsety;

	offsetx = sprite_width/2-sprite_xoffset;
	offsety = sprite_height/2-sprite_yoffset;

	fix[0] = physics_fixture_create();
	physics_fixture_set_circle_shape(fix[0], parent.len_cons_general);

	for (var i = 0; i < 1; i += 1) {
	  physics_fixture_set_density(fix[i], .5);
	  physics_fixture_set_friction(fix[i], 0.0);
	  physics_fixture_set_linear_damping(fix[i], 0.0);
	  physics_fixture_set_angular_damping(fix[i], 0.0);
	  physics_fixture_set_restitution(fix[i], 0.0);
	  physics_fixture_set_sensor(fix[i], 0);
	  physics_fixture_set_awake(fix[i], 1);
	  //physics_fixture_set_collision_group(fix[i],-1)
	  physics_fixture_bind_ext(fix[i], id, 0-offsetx, 0-offsety);
	  physics_fixture_delete(fix[i]);
	}



}
